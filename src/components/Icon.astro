---
interface Props {
  name:
    | 'arrow'
    | 'map'
    | 'clock'
    | 'ticket'
    | 'toilet'
    | 'sun'
    | 'paw'
    | 'car'
    | 'wind'
    | 'flower'
    | 'info'
    | 'check'
    | 'menu'
    | 'close'
    | 'cloud'
    | 'umbrella'

  {name === 'compass' && <><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/></>}
  {name === 'shirt' && <><path d="M8 3 4 6l2 3 2-1v10h8V8l2 1 2-3-4-3"/><path d="M8 3a4 4 0 0 0 8 0"/></>}
  {name === 'backpack' && <><path d="M5 9a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v11H5Z"/><path d="M9 6V5a3 3 0 0 1 6 0v1"/><path d="M5 13h14M10 20v-4h4v4"/></>}

---
interface Props {
  name: 'arrow' | 'map' | 'clock' | 'ticket' | 'toilet' | 'sun' | 'paw' | 'car' | 'wind' | 'flower' | 'info' | 'check' | 'menu' | 'close';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.8,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<svg {...common} class={className}>
  {name === 'arrow' && <><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></>}
  {name === 'map' && <><path d="M9 18 3.5 21V6L9 3l6 3 5.5-3v15L15 21z"/><path d="M9 3v15M15 6v15"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'ticket' && <><path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z"/><path d="M12 8v8"/></>}
  {name === 'toilet' && <><circle cx="8" cy="5" r="2"/><path d="M8 8v6m-3-2 3-4 3 4m-5 2-1 6m5-6 1 6"/><circle cx="17" cy="5" r="2"/><path d="M17 8v12m-3-7 3-5 3 5"/></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></>}
  {name === 'paw' && <><path d="M10.2 10.8c1.1-1 2.5-1 3.6 0 1.8 1.6 3.3 3.6 2 5.6-1 1.6-3.1.8-3.8.8s-2.8.8-3.8-.8c-1.3-2 .2-4 2-5.6Z"/><circle cx="7" cy="8" r="2"/><circle cx="17" cy="8" r="2"/><circle cx="10" cy="5" r="2"/><circle cx="14" cy="5" r="2"/></>}
  {name === 'car' && <><path d="m5 11 2-5h10l2 5"/><path d="M3 11h18v7H3z"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/></>}
  {name === 'wind' && <><path d="M3 8h11a3 3 0 1 0-3-3"/><path d="M3 12h15a3 3 0 1 1-3 3"/><path d="M3 16h7"/></>}
  {name === 'flower' && <><circle cx="12" cy="12" r="2"/><path d="M12 10c-4-5-7 1-2 2-5 4 1 7 2 2 4 5 7-1 2-2 5-4-1-7-2-2Z"/></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18"/></>}
</svg>

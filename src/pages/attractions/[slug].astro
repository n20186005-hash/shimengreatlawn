---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ManagementSection from '../../components/ManagementSection.astro';
import { site } from '../../data/site';
import { nearby } from '../../data/nearby';

export function getStaticPaths() { return nearby.map((place) => ({ params: { slug: place.slug }, props: { place } })); }
const { place } = Astro.props;
const url = `${site.url}/attractions/${place.slug}`;
const title = `${place.name}｜歷史、特色、交通與石門大草坪順遊指南`;
const description = `${place.intro} 整理遊覽重點、路線、地圖與官方來源。`;
const ticketInfo = place.slug === 'shimen-reservoir' ? '園區車輛入園及部分設施依水利署公告收費；不可套用石門大草坪規定。' : place.slug === 'shiyifen-cultural-park' ? '公共街區步行不設統一門票；展覽、活動及店家消費以現場公告為準。' : place.slug === 'shimen-mountain-trail' ? '一般開放步道無統一入山門票；個別停車及周邊服務依現場規定。' : '公共老街無統一門票；店家、活動與個別場館可能另行收費。';
const jsonLd = { '@context':'https://schema.org', '@graph': [
  { '@type':'TouristAttraction', '@id':`${url}#place`, name:place.name, description:place.intro, url, hasMap:place.map, address:{'@type':'PostalAddress',streetAddress:place.address,addressRegion:'桃園市',addressCountry:'TW'}, ...(place.image ? {image:place.image.startsWith('http') ? place.image : `${site.url}${place.image}`} : {}) },
  { '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'石門大草坪',item:`${site.url}/`},{'@type':'ListItem',position:2,name:place.name}] },
  { '@type':'FAQPage',mainEntity:place.faq.map((f)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
]};
---
<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd} image={place.image ? (place.image.startsWith('http') ? place.image : `${site.url}${place.image}`) : undefined} imageAlt={place.imageAlt}>
  <Header />
  <main id="main-content">
    <section class="relative min-h-[62svh] overflow-hidden bg-[#263326] text-white">
      {place.image && <img src={place.image} alt={place.imageAlt} width="1280" height="850" class="absolute inset-0 h-full w-full object-cover" />}
      <div class="absolute inset-0 bg-gradient-to-r from-[#172618]/95 via-[#172618]/80 to-[#172618]/45"></div>
      <div class="container-shell relative flex min-h-[62svh] flex-col justify-end pb-16 pt-32">
        <nav class="mb-6 text-sm text-white/75" aria-label="麵包屑"><a href="/" class="underline">石門大草坪</a> / {place.name}</nav>
        <p class="font-bold tracking-widest text-white/75">桃園龍潭周邊探索</p><h1 class="mt-4 text-5xl font-extrabold md:text-6xl">{place.name}</h1><p class="mt-5 max-w-3xl text-xl leading-9 text-white/85">{place.tagline}</p>
        <p class="mt-4 text-sm leading-7 text-white/85">開放資訊：{place.hours} · {place.address}</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary !bg-white !text-[#33422f]" href={place.map} target="_blank" rel="noopener noreferrer">查看專屬 Google 地圖 ↗</a><a class="btn-secondary !border-white/30 !text-white" href="/transport">大草坪交通停車</a></div>
      </div>
    </section>
    <section class="section-space bg-[#f7f5ed]"><div class="container-shell max-w-5xl"><h2 class="text-3xl font-extrabold text-[#293b2d]">探索景點</h2><p class="mt-5 max-w-4xl text-lg leading-9">{place.intro}</p><h3 class="mt-10 text-2xl font-extrabold">遊覽建議與景區特色</h3><div class="mt-6 grid gap-4 md:grid-cols-3">{place.highlights.map((h,i)=><article class="rounded-3xl bg-white p-7"><span class="font-bold text-[#668361]">0{i+1}</span><p class="mt-3 leading-8">{h}</p></article>)}</div></div></section>
    <ManagementSection name={place.name} manager={place.manager} description={place.management} sourceUrl={place.secondarySource} />
    <section class="section-space bg-white"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-extrabold text-[#293b2d]">歷史與地方文化</h2><p class="mt-6 text-lg leading-9">{place.history}</p><h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">基本資料</h2><dl class="mt-6 grid gap-5 rounded-3xl bg-[#eef1e9] p-7 sm:grid-cols-2"><div><dt class="font-extrabold">景點名稱</dt><dd class="mt-2">{place.name}</dd></div><div><dt class="font-extrabold">位置／地址參考</dt><dd class="mt-2">{place.address}</dd></div><div><dt class="font-extrabold">開放時間</dt><dd class="mt-2">{place.hours}</dd></div><div><dt class="font-extrabold">門票費用</dt><dd class="mt-2">{ticketInfo}</dd></div><div><dt class="font-extrabold">管理／維護</dt><dd class="mt-2">{place.manager}</dd></div><div><dt class="font-extrabold">Google 地圖</dt><dd class="mt-2"><a class="underline" href={place.map} target="_blank" rel="noopener noreferrer">查看 {place.name} 專屬位置 ↗</a></dd></div></dl>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">開放時間與參觀安排</h2><p class="mt-5 leading-9">{place.hours}。此處的道路、戶外區域與室內場館可能適用不同開放規則，出發前應以管理單位公告及現場告示核實。</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">門票價格與相關費用</h2><p class="mt-5 leading-9">{ticketInfo} 停車、交通及餐飲費用亦須按使用的設施分別查詢。</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">建築與工程觀察重點</h2><p class="mt-5 leading-9">{place.architecture}</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">交通方式</h2><p class="mt-4 leading-8">{place.transport} 另可參考<a class="underline" href="https://travel.tycg.gov.tw/zh-tw/traffic/shihmen/" target="_blank" rel="noopener noreferrer">桃園觀光大龍門線</a>，並依實際班次安排行程。</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">遊覽路線</h2><ol class="mt-6 space-y-4">{place.route.map((step,i)=><li class="flex gap-5 rounded-2xl border border-[#d8e1d4] p-5"><span class="text-xl font-extrabold text-[#668361]">{i+1}</span><span class="leading-8">{step}</span></li>)}</ol>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">遊覽須知</h2><ul class="mt-6 list-disc space-y-3 pl-6 leading-8">{place.tips.map((tip)=><li>{tip}</li>)}</ul>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">拍照機位與觀察角度</h2><ol class="mt-6 space-y-4">{place.photoSpots.map((spot,i)=><li class="rounded-2xl bg-[#eff2e9] p-5 leading-8"><strong class="mr-3 text-[#668361]">{String(i+1).padStart(2,'0')}</strong>{spot}</li>)}</ol>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">住宿與周邊安排</h2><p class="mt-4 leading-9">{place.stay}</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">景點照片</h2>
      <figure class="mt-6 overflow-hidden rounded-3xl bg-[#eff2e9]">{place.image && <img src={place.image} alt={place.imageAlt} width="1280" height="850" loading="lazy" class="max-h-[32rem] w-full object-cover" />}<figcaption class="p-5 text-sm text-[#526451]">{place.imageAlt}{place.slug === 'shiyifen-cultural-park' ? ' · 十一份街區實景' : ' · 桃園市觀光旅遊局景點影像'}</figcaption></figure>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">旅客評價與地圖導覽</h2><p class="mt-4 leading-9">旅客可透過 Google 地圖查看近期公開評價、照片和抵達前的道路資訊。本站不提供未核實的星等、評論數或逐字評論，以免與即時資料混淆。</p><a href={place.map} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block font-extrabold text-[#52754e] underline">查看 {place.name} 的 Google 地圖評價 ↗</a>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">交通指南與地點定位</h2><p class="mt-4 leading-9">地址參考：{place.address}。{place.transport}</p><a href={place.map} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-xl bg-[#52754e] px-6 py-3 font-bold text-white">前往 {place.name} Google 地圖 ↗</a>
    </div></section>
    <section class="section-space bg-[#eef0e7]"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-extrabold">常見問題</h2><div class="mt-6 space-y-4">{place.faq.map((f)=><details class="rounded-2xl bg-white p-6"><summary class="cursor-pointer font-bold">{f.q}</summary><p class="mt-4 leading-8">{f.a}</p></details>)}</div></div></section>
    <section class="section-space bg-white"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-extrabold">順遊與延伸閱讀</h2><div class="mt-6 flex flex-wrap gap-4"><a href="/" class="rounded-xl border px-5 py-3 font-bold">石門大草坪首頁 →</a>{nearby.filter(p=>p.slug!==place.slug).map((p)=><a class="rounded-xl border px-5 py-3 font-bold" href={`/attractions/${p.slug}`}>{p.name} →</a>)}<a href="/guides/shiyifen-half-day" class="rounded-xl border px-5 py-3 font-bold">十一份半日遊 →</a></div><h2 class="mt-12 text-2xl font-extrabold">資料來源</h2><p class="mt-3 text-sm">資料核對：2026 年 11 月 18 日。動態資訊請以官方與現場公告為準。</p><ul class="mt-4 list-disc space-y-3 pl-6"><li><a href={place.source} target="_blank" rel="noopener noreferrer" class="underline">{place.sourceLabel} ↗</a></li><li><a href={place.secondarySource} target="_blank" rel="noopener noreferrer" class="underline">{place.secondaryLabel} ↗</a></li></ul>{!place.image && <p class="mt-5 text-sm text-[#657064]">專屬實景照片尚在整理，本頁暫不使用其他景點照片替代。</p>}</div></section>
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const canonical = `${site.url}/guides/${guide.slug}`;
const description = `${guide.intro.slice(0, 105)} 查看行程、注意事項、常見問題與官方參考資料。`;
const supportingPhotos = guide.slug === 'fringe-flower-season'
  ? [{ src: '/images/residence-1280.webp', alt: '十一份老宿舍街區與周邊植栽' }, { src: '/images/lawn-1280.webp', alt: '石門大草坪與周邊綠地' }]
  : guide.slug === 'family-picnic'
  ? [{ src: '/images/hero-1280.webp', alt: '石門大草坪與樹蔭環境' }, { src: '/images/temple-1280.webp', alt: '附近集福宮與老榕樹' }]
  : [{ src: '/images/temple-1280.webp', alt: '十一份集福宮與老榕樹' }, { src: '/images/trail-1024.webp', alt: '十一份挑擔古道步道' }];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: guide.title, description, inLanguage: site.lang, about: { '@id': `${site.url}/#attraction` }, dateModified: '2026-11-18' },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首頁', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: guide.short }] },
    { '@type': 'FAQPage', mainEntity: guide.faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---

<BaseLayout title={guide.title} description={description} canonical={canonical} jsonLd={jsonLd} image={`${site.url}${guide.image}`} imageAlt={guide.imageAlt}>
  <Header />
  <main id="main-content">
    <section class="relative min-h-[67svh] overflow-hidden bg-[#263326] text-white">
      <img src={guide.image} alt={guide.imageAlt} class="absolute inset-0 h-full w-full object-cover" width="1280" height="850" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#172618]/95 via-[#172618]/75 to-[#172618]/35"></div>
      <div class="container-shell relative flex min-h-[67svh] flex-col justify-end pb-16 pt-32">
        <nav aria-label="麵包屑" class="mb-6 text-sm text-white/75"><a href="/" class="underline">石門大草坪</a> / {guide.short}</nav>
        <p class="font-bold tracking-[.15em] text-white/70">{guide.eyebrow} · 桃園龍潭</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">{guide.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-white/85">{guide.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary !bg-white !text-[#33422f]" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google 地圖定位 ↗</a><a class="btn-secondary !border-white/30 !text-white" href="/transport">停車與交通</a></div>
      </div>
    </section>
    <section class="section-space bg-[#f7f5ed]">
      <div class="container-shell max-w-5xl">
        <h2 class="text-3xl font-extrabold text-[#293b2d]">遊覽建議與看點</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">{guide.highlights.map((item, i) => <article class="rounded-3xl bg-white p-7 shadow-sm"><span class="text-sm font-bold text-[#64805e]">0{i + 1}</span><p class="mt-4 leading-8 text-[#445044]">{item}</p></article>)}</div>
      </div>
    </section>
    <section class="section-space bg-white"><div class="container-shell max-w-4xl">
      <h2 class="text-3xl font-extrabold text-[#293b2d]">關於十一份的歷史與景觀</h2><p class="mt-6 text-lg leading-9 text-[#465448]">{guide.history}</p>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">基本資訊</h2>
      <dl class="mt-6 grid gap-4 rounded-3xl bg-[#f5f4eb] p-7 sm:grid-cols-2"><div><dt class="font-bold">地點</dt><dd class="mt-2">石門大草坪、桃園市龍潭區十一份</dd></div><div><dt class="font-bold">導航</dt><dd class="mt-2"><a class="underline" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">石門大草坪專屬地圖</a></dd></div><div><dt class="font-bold">地址參考</dt><dd class="mt-2">{site.address}</dd></div><div><dt class="font-bold">開放與費用</dt><dd class="mt-2">一般草地休憩；活動管制及場地申請依管理單位公告</dd></div></dl>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">景點實景與拍照觀察</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">{supportingPhotos.map((photo) => <figure class="overflow-hidden rounded-2xl bg-[#f3f5ee]"><img src={photo.src} alt={photo.alt} width="1280" height="850" loading="lazy" class="aspect-[4/3] w-full object-cover" /><figcaption class="p-4 text-sm text-[#556452]">{photo.alt}</figcaption></figure>)}</div>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">建議遊覽路線</h2><ol class="mt-7 space-y-5">{guide.route.map((step, i) => <li class="flex gap-5 rounded-2xl border border-[#dce3d5] p-5"><span class="text-xl font-extrabold text-[#63815e]">{String(i + 1).padStart(2, '0')}</span><p class="leading-8">{step}</p></li>)}</ol>
      <h2 class="mt-14 text-3xl font-extrabold text-[#293b2d]">出發前注意事項</h2><ul class="mt-6 list-disc space-y-3 pl-6 leading-8">{guide.tips.map((tip) => <li>{tip}</li>)}</ul>
    </div></section>
    <section class="section-space bg-[#eef0e7]"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-extrabold text-[#293b2d]">常見問題</h2><div class="mt-7 space-y-4">{guide.faqs.map((item) => <details class="rounded-2xl bg-white p-6"><summary class="cursor-pointer font-bold">{item.q}</summary><p class="mt-4 leading-8">{item.a}</p></details>)}</div></div></section>
    <section class="section-space bg-white"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-extrabold text-[#293b2d]">延伸探索</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{guides.filter((item) => item.slug !== guide.slug).map((item) => <a href={`/guides/${item.slug}`} class="rounded-2xl border border-[#dce3d5] p-5 font-bold text-[#334b35] hover:bg-[#f3f5ed]">{item.short} →</a>)}<a href="/transport" class="rounded-2xl border border-[#dce3d5] p-5 font-bold text-[#334b35] hover:bg-[#f3f5ed]">石門大草坪交通停車 →</a></div>
      <h2 class="mt-14 text-2xl font-extrabold text-[#293b2d]">參考資料</h2><p class="mt-2 text-sm text-[#667064]">資料查核：2026 年 11 月 18 日。動態開放、交通與現場使用規則以管理單位最新公告為準。</p><ul class="mt-5 list-disc space-y-3 pl-6">{guide.sources.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer" class="underline">{item.label} ↗</a></li>)}</ul>
    </div></section>
  </main>
  <Footer />
</BaseLayout>

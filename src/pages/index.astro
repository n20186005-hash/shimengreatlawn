---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VisitDiagram from '../components/VisitDiagram.astro';
import RatingStars from '../components/RatingStars.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import WeatherSection from '../components/WeatherSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import SeasonStrategy from '../components/SeasonStrategy.astro';
import PlansSection from '../components/PlansSection.astro';
import StewardshipSection from '../components/StewardshipSection.astro';
import { site, ratingSourceLine } from '../data/site';

/** 歸屬層級：景點 → 城市 → 省市 → 國家 */
const geoHierarchy = [site.name, site.city, site.state, site.country];

const breadcrumbs = [
  { name: '首頁', url: `${site.url}/` },
  { name: site.country, url: `${site.url}/#about` },
  { name: site.state, url: `${site.url}/#about` },
  { name: site.city, url: `${site.url}/#about` },
  { name: site.name, url: `${site.url}/#about` },
];

const facts = [
  { icon: 'ticket', label: '費用', value: '免費開放' },
  { icon: 'clock', label: '建議停留', value: '1–2 小時' },
  { icon: 'toilet', label: '公共設施', value: '周邊有廁所' },
  { icon: 'sun', label: '遮蔭', value: '外圍較多' },
  { icon: 'paw', label: '毛孩', value: '牽繩同行' },
  { icon: 'car', label: '停車', value: '依現場指引' },
] as const;

const playCards = [
  {
    number: '01',
    title: '鋪一張野餐墊',
    text: '草坪中央視野最開闊，外圍樹下比較適合久坐。帶上飲水、防曬、垃圾袋，就能慢慢待一個下午。',
    icon: 'sun',
  },
  {
    number: '02',
    title: '讓風箏升上去',
    text: '少了高樓與密集設施，風箏有足夠空間起飛。假日請留意其他風箏線，也別在幼童密集處快速收線。',
    icon: 'wind',
  },
  {
    number: '03',
    title: '陪孩子跑一圈',
    text: '這裡的主角是草地，不是大型遊具。足球、飛盤、泡泡與簡單球類，往往比排隊玩設施更自在。',
    icon: 'check',
  },
  {
    number: '04',
    title: '帶毛孩散步',
    text: '空間寬敞，但仍有孩子、車輛與其他犬隻。建議全程牽繩、自備飲水，並主動清理排泄物。',
    icon: 'paw',
  },
] as const;

const seasons = [
  { months: '2–3 月', title: '春日散步', text: '氣溫舒適，周邊宿舍區偶有春花，適合散步與拍攝老街廓。' },
  { months: '3 月底–4 月', title: '流蘇花期', text: '白色細長花瓣像落在枝頭的雪，是一年中最具代表性的季節景觀。' },
  { months: '5–9 月', title: '草地時光', text: '草色明亮，但正午炎熱、午後雷雨較常見，建議早晨或傍晚到訪。' },
  { months: '10–1 月', title: '舒服放風', text: '體感較涼，適合長時間野餐與放風箏；風大時記得多帶一件外套。' },
] as const;

const itineraries = [
  {
    time: '30 分鐘',
    title: '路過也能走走',
    items: ['草坪外圈散步', '集福宮與老榕樹', '拍一張開闊全景'],
  },
  {
    time: '90 分鐘',
    title: '剛好的草地午後',
    items: ['野餐或放風箏', '走看老宿舍街區', '到十一份園區休息'],
  },
  {
    time: '半日',
    title: '親子慢遊十一份',
    items: ['石門大草坪', '十一份觀光文化園區', '文化路活魚用餐'],
  },
  {
    time: '全日',
    title: '龍潭水與草的一日',
    items: ['石門大草坪野餐放風', '十一份觀光文化園區', '石門水庫園區與壩頂', '文化路活魚晚餐'],
  },
] as const;

const faqs = [
  {
    q: '石門大草坪需要門票嗎？',
    a: '一般休閒使用免費，不需要購票。若公司、學校或團體要舉辦正式活動，應依管理單位規定事先提出場地申請。',
  },
  {
    q: '石門大草坪就是石門水庫嗎？',
    a: '不是。大草坪位在龍潭十一份、北區水資源分署辦公區前，並不是水庫壩頂或收費入口。想看湖景與大壩，仍要另外前往石門水庫園區。',
  },
  {
    q: '現場有廁所與遮蔭嗎？',
    a: '辦公區周邊設有廁所，草坪外圍也有樹蔭與休息空間；但開放狀態可能因維護或時段調整。草坪中央遮蔭較少，晴天務必防曬。',
  },
  {
    q: '可以搭帳篷、煮食或烤肉嗎？',
    a: '不建議把這裡當露營地，也不要使用明火。小型遮陽用品與現場使用規範，請以當日告示及管理單位指引為準。',
  },
  {
    q: '流蘇花大約什麼時候開？',
    a: '通常以三月底到四月初最受關注，但每年會受溫度、降雨與風勢影響。花季造訪時，建議把「看到盛開」當作驚喜，而不是保證。',
  },
  {
    q: '雨天或雨後適合去嗎？',
    a: '雨天不適合草地活動；雨後草皮可能濕軟、積水或沾泥。帶幼童與毛孩時，可準備替換衣物、鞋袋和毛巾。',
  },
  {
    q: '寵物可以進入嗎？',
    a: '一般可在公共草地散步，建議全程牽繩、避開人群與辦公區出入口，並自行清理排泄物。若現場有臨時活動或管制，請配合告示。',
  },
  {
    q: '石門大草坪在哪裡？地址與座標是多少？',
    a: '石門大草坪位於臺灣桃園市龍潭區佳安里佳安路2號、北區水資源分署十一份辦公區前，座標約為北緯 24.83509、東經 121.24165。導航請直接搜尋「石門大草坪」，避免被帶往石門水庫壩頂。',
  },
  {
    q: '石門大草坪周邊還能順遊哪裡？',
    a: '步行可達十一份觀光文化園區與集福宮老榕樹，開車短程可銜接石門水庫園區與文化路活魚街。把大草坪當作龍潭行程中的放鬆節點最剛好。',
  },
  {
    q: '天氣與帶傘怎麼判斷？',
    a: '本頁提供即時天氣與未來七日預報，並依當日降雨機率與降水，給出「出門要不要帶傘」的建議。本地午後雷陣雨常見，出發前再看一次最準。',
  },
  {
    q: '周邊有推薦的餐廳、住宿或商家嗎？',
    a: '本站為非營利科普網站，不個別推薦特定商家。周邊以活魚餐飲、地方小吃、便利商店、超市與旅宿為主，可依當日需求自行選擇，並以現場營業狀況與價格為準。',
  },
] as const;

/**
 * 結構化資料（JSON-LD）
 * 注意：Google 地圖的評分與評價僅在頁面呈現，
 * 依第三方內容引用規範不寫入 aggregateRating / review，避免被判為違規。
 */
const attractionSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      alternateName: [site.shortName, `${site.city}${site.name}`, site.nameEn],
      inLanguage: 'zh-Hant-TW',
      description: site.description,
      publisher: { '@id': `${site.url}/#attraction` },
    },
    {
      '@type': 'TouristAttraction',
      '@id': `${site.url}/#attraction`,
      name: site.name,
      alternateName: [
        site.shortName,
        `${site.city}${site.name}`,
        '石管局大草坪',
        '北水局大草坪',
        '石門十一份大草坪',
        site.nameEn,
      ],
      description: `Comprehensive visitor guide to ${site.nameEn} (${site.name}) in ${site.city}, ${site.state}, ${site.country}. 位於${site.state}${site.city}十一份辦公區前的開闊公共草地，適合野餐、放風箏、親子活動與春季賞流蘇花。`,
      url: site.url,
      image: [
        `${site.url}/images/hero-1920.webp`,
        `${site.url}/images/lawn-1280.webp`,
        `${site.url}/images/residence-1280.webp`,
        `${site.url}/images/temple-1280.webp`,
      ],
      isAccessibleForFree: true,
      publicAccess: true,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.streetAddress,
        addressLocality: site.city,
        addressRegion: site.state,
        postalCode: site.postalCode,
        addressCountry: site.countryCode,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.latitude,
        longitude: site.longitude,
      },
      hasMap: site.mapsShareUrl,
      sameAs: [site.mapsShareUrl, site.govtTourismUrl],
      containedInPlace: {
        '@type': 'Place',
        name: '十一份辦公園區',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${site.url}/#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        ...(index < breadcrumbs.length - 1 ? { item: crumb.url } : {}),
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/#faq`,
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout jsonLd={attractionSchema}>
  <Header />

  <main id="main-content">
    <section class="relative min-h-[92svh] overflow-hidden bg-[#263326] text-white">
      <picture class="absolute inset-0">
        <source
          type="image/webp"
          srcset="/images/hero-640.webp 640w, /images/hero-960.webp 960w, /images/hero-1280.webp 1280w, /images/hero-1920.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/images/hero-1280.webp"
          alt="石門大草坪（Shimen Great Lawn）— 龍潭區、臺灣主視覺：開闊草地、樹木與藍天"
          width="1920"
          height="1080"
          fetchpriority="high"
          class="h-full w-full object-cover object-center"
        />
      </picture>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,29,18,.86)_0%,rgba(17,29,18,.58)_45%,rgba(17,29,18,.2)_74%,rgba(17,29,18,.38)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#263326] to-transparent"></div>

      <div class="container-shell relative z-10 flex min-h-[92svh] flex-col justify-end pb-16 pt-32 md:pb-24">
        <div class="max-w-4xl">
          <p class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-extrabold tracking-[.15em] text-white/88 backdrop-blur-md">
            桃園・龍潭・十一份
          </p>
          <h1 class="display-title mt-7 max-w-[13ch]">石門大草坪<br /><span class="text-white/62">龍潭區的一片風與草地</span></h1>
          <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 sm:text-lg">
            石門大草坪是一片免費、開闊的日常風景。帶一張野餐墊、一只風箏，或只是慢慢走過老宿舍與樹影，就很足夠。
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 rounded-2xl border border-white/15 bg-white/8 px-5 py-4 backdrop-blur-md">
            <RatingStars rating={site.googleRating} size={22} class="text-[#f2b544]" label={`Google 地圖評分 ${site.googleRatingValue} 分`} />
            <p class="text-sm font-extrabold text-white">
              <span class="text-lg">{site.googleRatingValue}</span>
              <span class="ml-1 text-white/70">／5</span>
              <span class="ml-2 text-white/78">共 {site.googleReviewCountText} 則評價</span>
            </p>
            <a
              class="text-sm font-extrabold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
              href={site.mapsShareUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              點擊查看谷歌地圖全部評價 ↗
            </a>
          </div>
          <p class="fine-print mt-3 !text-white/55">
            {ratingSourceLine}
            <a class="ml-1 underline decoration-white/30 underline-offset-4 hover:decoration-white/70" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">點擊查看谷歌地圖全部評價↗</a>
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a class="btn-primary !bg-white !text-[#33422f] hover:!bg-[#f5f4ec]" href="#visit">
              先看行前資訊
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn-secondary !border-white/25 !bg-white/8 !text-white hover:!bg-white/14" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="map" size={18} />
              開啟導航
            </a>
          </div>
        </div>

        <div class="mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/16 pt-5 text-sm font-bold text-white/72">
          <span>免費入園</span>
          <span>親子友善</span>
          <span>適合野餐</span>
          <span>春季流蘇花</span>
          <span>建議停留 1–2 小時</span>
        </div>
      </div>
    </section>

    <WeatherSection />

    <section id="visit" class="relative -mt-px bg-[#263326] pb-20 text-white md:pb-28">
      <div class="container-shell">
        <div class="rounded-[2rem] border border-white/12 bg-white/8 p-5 backdrop-blur-xl sm:p-8">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
            {facts.map((fact) => (
              <div class="rounded-2xl bg-white/7 p-4">
                <span class="grid size-9 place-items-center rounded-full bg-white/10 text-[#dfe8d7]">
                  <Icon name={fact.icon} size={18} />
                </span>
                <p class="mt-5 text-xs font-bold tracking-[.13em] text-white/48">{fact.label}</p>
                <p class="mt-1 font-extrabold">{fact.value}</p>
              </div>
            ))}
          </div>
          <div class="mt-5 flex gap-3 rounded-2xl bg-[#f0d9bf]/12 p-4 text-sm leading-6 text-white/72">
            <span class="mt-0.5 shrink-0 text-[#f0d9bf]"><Icon name="info" size={18} /></span>
            <p>戶外草坪一般可供民眾休閒使用；廁所、停車與局部區域可能因活動、維護或辦公需求調整，請以現場告示為準。</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section-space bg-[#f6f3ea]">
      <div class="container-shell">
        <nav class="flex flex-wrap items-center gap-2 text-sm text-[#7a8177]" aria-label="麵包屑">
          {breadcrumbs.map((crumb, index) => (
            <span class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true">/</span>}
              {index === breadcrumbs.length - 1 ? (
                <span class="font-extrabold text-[#33412f]" aria-current="page">{crumb.name}</span>
              ) : (
                <a class="transition hover:text-[#33412f] hover:underline" href={crumb.url}>{crumb.name}</a>
              )}
            </span>
          ))}
        </nav>

        <h2 class="section-title !max-w-[20ch] mt-8">關於石門大草坪：龍潭區十一份的開闊草地</h2>

        <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
          <div>
            <p class="body-lead">
              歡迎來到<strong class="text-[#33412f]">石門大草坪</strong>（Shimen Great Lawn）。不論被稱作「石管局大草坪」、「北水局大草坪」或「石門十一份大草坪」，指的都是同一片草地。它位於<strong class="text-[#33412f]">臺灣桃園市龍潭區</strong>十一份、北區水資源分署辦公區前，是造訪龍潭與石門水庫一帶時最常被安排進行程的休息節點。
            </p>
            <p class="mt-6 leading-8 text-[#687267]">
              這裡沒有圍籬、沒有門票，也沒有固定的遊覽動線。一片夠大的草皮、一圈可以遮蔭的老樹，加上十一份宿舍區留下來的低矮房舍，就構成它最完整的樣子。
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl border border-black/8 bg-white/60 px-5 py-4 text-sm font-bold text-[#5b665a]">
              <span class="text-[#7a8177]">歸屬層級</span>
              {geoHierarchy.map((item, index) => (
                <span class="flex items-center gap-3">
                  {index > 0 && <span class="text-[#a9b0a5]" aria-hidden="true">→</span>}
                  <span class={index === 0 ? 'text-[#33412f]' : ''}>{item}</span>
                </span>
              ))}
            </div>

            <p class="mt-8 leading-8 text-[#687267]">
              造訪<strong class="text-[#33412f]">石門大草坪</strong>時，旅客可以順道認識周邊的歷史地標與景點，包括<strong class="text-[#33412f]">十一份觀光文化園區</strong>與<strong class="text-[#33412f]">石門水庫</strong>；兩者都在短程車程內，很適合與草地時光排在同一天。
            </p>
          </div>

          <dl class="grid gap-4 rounded-[1.8rem] border border-black/8 bg-white/62 p-6 sm:p-8">
            <div class="border-b border-black/8 pb-4">
              <dt class="text-xs font-extrabold tracking-[.15em] text-[#7a8177]">官方全稱</dt>
              <dd class="mt-2 text-xl font-extrabold tracking-[-.03em]">{site.name}</dd>
              <dd class="mt-1 text-sm text-[#7a8177]">{site.nameEn}</dd>
            </div>
            <div class="border-b border-black/8 pb-4">
              <dt class="text-xs font-extrabold tracking-[.15em] text-[#7a8177]">常用俗稱</dt>
              <dd class="mt-2 leading-7">石管局大草坪、北水局大草坪、石門十一份大草坪</dd>
            </div>
            <div class="border-b border-black/8 pb-4">
              <dt class="text-xs font-extrabold tracking-[.15em] text-[#7a8177]">地址</dt>
              <dd class="mt-2 leading-7">{site.address}</dd>
            </div>
            <div class="border-b border-black/8 pb-4">
              <dt class="text-xs font-extrabold tracking-[.15em] text-[#7a8177]">座標</dt>
              <dd class="mt-2 font-mono text-sm font-bold">{site.latitude}, {site.longitude}</dd>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <dt class="text-xs font-extrabold tracking-[.15em] text-[#7a8177]">Google 地圖分類</dt>
                <dd class="mt-2 font-extrabold">{site.category}</dd>
              </div>
              <a class="text-sm font-extrabold text-[#465239] underline decoration-[#465239]/30 underline-offset-4" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">
                在 Google 地圖查看
              </a>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section-space overflow-hidden">
      <div class="container-shell">
        <SectionHeading
          eyebrow="HOW TO ENJOY"
          title="這裡沒有太多安排，<br />反而更好玩"
